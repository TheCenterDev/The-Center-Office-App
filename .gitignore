# PyInstaller build output — regenerated every build, not source code
build/
dist/

# Mobile/web site build output — regenerated by scripts/build_site.py
# (and by the "Build and deploy mobile site" GitHub Actions workflow)
# from web/ + html/ every time; not source code.
_site/
# Note: launcher.spec is deliberately NOT ignored — it's checked-in source
# config (sets NSHighResolutionCapable, icons, collect-all), not build output.
# PyInstaller auto-generates a spec named after --name if you ever run the
# old CLI-flags build command again; ignore that one specifically.
TheCenterOfficeLauncher.spec

# Python cache
__pycache__/
*.pyc

# macOS
.DS_Store

# Runtime data generated next to the app on each machine — real names,
# emails, and passwords, plus personal display settings and crash logs.
# Never meant to be committed, same reasoning as settings.json and
# error_log.txt (which simply never get created inside this folder to
# begin with, since the packaged app keeps its copies in /Applications).
users.json
settings.json
error_log.txt
shared_preferences.json

# Firebase Admin SDK service account key (scripts/create_logins.js) --
# this is a master key with full admin access to the Firebase project.
# Never commit it. Download it fresh from the Firebase console each time
# you need it (Project settings -> Service accounts -> Generate new
# private key) and delete the file again when you're done.
scripts/service-account.json

# Node dependencies for scripts/create_logins.js.
node_modules/

# Personal sign-in links generated for new staff -- these let whoever
# has the link set an account password, so they're as sensitive as a
# temporary password and shouldn't be committed either.
scripts/login-links-*.txt
