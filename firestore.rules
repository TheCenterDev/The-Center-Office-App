rules_version = '2';

// Security rules for the mobile site's Firestore database (see
// web/auth.js). This file is NOT deployed automatically -- there's no
// Firebase CLI step in this repo's build. Paste this into the Firebase
// console once: Build -> Firestore Database -> Rules tab -> replace
// the contents -> Publish. Update it here too if you ever change it in
// the console, so this file stays the source of truth.
//
// Model: one document per person in the "users" collection, keyed by
// their lowercased email (matching the desktop app's users.json). A
// signed-in person can always read their own document and update only
// its "preferences" field (theme/font size/etc, synced across
// devices). Only Admin/Director accounts can read the whole roster,
// or create/edit/delete anyone's name and role -- there is no
// self-service sign-up anywhere in the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(emailKey())).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(emailKey()));
    }

    function isAdminOrDirector() {
      return isSignedIn() && hasProfile() && myProfile().role in ['admin', 'director'];
    }

    match /users/{email} {
      allow get: if isSignedIn() && (emailKey() == email || isAdminOrDirector());
      allow list: if isAdminOrDirector();

      allow create, delete: if isAdminOrDirector();

      // Admin/Director can change anything on any profile. A regular
      // person can only touch their own "preferences" map -- not their
      // own name or role, so nobody can promote themselves.
      allow update: if isAdminOrDirector() || (
        isSignedIn() && emailKey() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.name == resource.data.name
      );
    }

    // Shared data for the interactive tools (Building Maintenance Log,
    // New Hire Onboarding Tracker -- see those files' own <script>
    // blocks). Same flat permission model the old single-device
    // localStorage versions had: any signed-in person with a real
    // profile can read, add, edit, or delete -- no extra role gate,
    // since these are everyday operational tools, not admin features.
    match /maintenance_log/{entryId} {
      allow read, write: if isSignedIn() && hasProfile();
    }

    match /onboarding_hires/{hireId} {
      allow read, write: if isSignedIn() && hasProfile();
    }

    // The recurring reporting calendar (JDAI, surveys, year-end
    // close-out, and the ended-but-kept CCLC cycle). Everyone reads it;
    // Admin/Director change it, since it defines obligations for the
    // whole organisation. The "posted" document under here is written by
    // the deadline-to-Todoist job, which runs with admin credentials in
    // GitHub Actions and so isn't restricted by these rules.
    match /reporting_calendar/{docId} {
      allow read: if isSignedIn() && hasProfile();
      allow write: if isAdminOrDirector();
    }

    // The onboarding checklist itself (the sections and items every new
    // hire gets), as opposed to any one hire's ticked boxes above.
    // Everyone signed in needs to read it to see their checklist, but
    // editing it changes what every future hire is onboarded against,
    // so writing is Admin/Director only. The tool hides its Edit button
    // from everyone else, but that's only cosmetic -- anything running
    // in a browser can be bypassed, so the real restriction is here.
    match /onboarding_template/{docId} {
      allow read: if isSignedIn() && hasProfile();
      allow write: if isAdminOrDirector();
    }
  }
}
