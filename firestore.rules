rules_version = '2';

// Security rules for the Firestore database behind both the desktop app
// and the mobile site (see web/auth.js and html/center-session.js).
//
// This file IS the live rule set: pushing a change to it on main
// publishes it, via .github/workflows/firestore-rules.yml. Editing the
// rules in the Firebase console instead will work until the next push
// to this file, which will overwrite it -- so change it here.
//
// It used to say "paste this into the console", and the result was that
// new collections shipped with their tool but without their
// permissions, and the tool answered "Missing or insufficient
// permissions" until somebody remembered the second step.
//
// Model: one document per person in the "users" collection, keyed by
// their lowercased email (matching the desktop app's users.json). A
// signed-in person can always read their own document and update only
// its "preferences" field (theme/font size/etc, synced across
// devices). Only Admin/Director accounts can read the whole roster,
// or create/edit/delete anyone's name and role -- there is no
// self-service sign-up anywhere in the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(emailKey())).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(emailKey()));
    }

    function isAdminOrDirector() {
      return isSignedIn() && hasProfile() && myProfile().role in ['admin', 'director'];
    }

    match /users/{email} {
      allow get: if isSignedIn() && (emailKey() == email || isAdminOrDirector());
      allow list: if isAdminOrDirector();

      allow create, delete: if isAdminOrDirector();

      // Admin/Director can change anything on any profile. A regular
      // person can only touch their own "preferences" map -- not their
      // own name or role, so nobody can promote themselves.
      allow update: if isAdminOrDirector() || (
        isSignedIn() && emailKey() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.name == resource.data.name
      );
    }

    // Shared data for the interactive tools (Building Maintenance Log,
    // New Hire Onboarding Tracker -- see those files' own <script>
    // blocks). Same flat permission model the old single-device
    // localStorage versions had: any signed-in person with a real
    // profile can read, add, edit, or delete -- no extra role gate,
    // since these are everyday operational tools, not admin features.
    match /maintenance_log/{entryId} {
      allow read, write: if isSignedIn() && hasProfile();
    }

    match /onboarding_hires/{hireId} {
      allow read, write: if isSignedIn() && hasProfile();
    }

    // Tap-counter entries (headcount, snacks, meals, volunteers, van
    // riders). One document per saved count, never edited in place, so
    // two people counting the same service add up instead of
    // overwriting each other. Everyone with a profile can add and read;
    // an entry may only be removed by whoever recorded it, so a
    // miscount can be fixed without anyone being able to quietly delete
    // someone else's numbers before they're reported.
    match /count_log/{entryId} {
      allow read, create: if isSignedIn() && hasProfile();
      allow update: if isSignedIn() && resource.data.by == emailKey();
      allow delete: if isSignedIn() && resource.data.by == emailKey();
    }

    // Notes. Three kinds, distinguished by the visibility field:
    //   "private" -- only the author, including not Admin/Director
    //   "team"    -- anyone signed in with a profile
    //   "direct"  -- the author plus the people named in recipients
    //
    // This is the actual enforcement. The Notes page decides what to
    // display, but a private note cannot be fetched by anyone else
    // however they ask, because read is denied here.
    //
    // Note the deliberate absence of an Admin/Director override: people
    // only use a private notes feature if private means private. A
    // Director who genuinely needs a note can still reach it through the
    // Firebase console, which is a visible, deliberate act rather than a
    // silent capability inside the app.
    //
    // The update rule lets a recipient add themselves to readBy and
    // change nothing else, so being sent a note doesn't grant the power
    // to rewrite it.
    match /notes/{noteId} {
      allow read: if isSignedIn() && hasProfile() && (
        resource.data.author == emailKey() ||
        resource.data.visibility == 'team' ||
        emailKey() in resource.data.recipients
      );

      allow create: if isSignedIn() && hasProfile() &&
        request.resource.data.author == emailKey();

      allow update: if isSignedIn() && hasProfile() && (
        resource.data.author == emailKey() || (
          emailKey() in resource.data.recipients &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        )
      );

      allow delete: if isSignedIn() && resource.data.author == emailKey();
    }

    // Calendar dates. Same three-way visibility as notes above, and the
    // same reasoning: this is the enforcement, the page only decides
    // what to draw. A "just me" date cannot be fetched by anyone else
    // however they ask, and there is deliberately no Admin/Director
    // override, matching the choice made for Notes.
    //
    // Anyone with a profile may create a team-wide date -- that was a
    // deliberate call rather than an oversight, on the grounds that the
    // people using this are a dozen colleagues, not the public.
    //
    // Unlike notes there is no recipient-can-update carve-out: being put
    // on someone's calendar doesn't let you edit their entry. Only the
    // author can change or remove a date.
    match /calendar_events/{eventId} {
      allow read: if isSignedIn() && hasProfile() && (
        resource.data.author == emailKey() ||
        resource.data.visibility == 'team' ||
        emailKey() in resource.data.recipients
      );

      // Create validates the shape, not just the author. The read rule
      // above dereferences visibility and recipients directly, and rules
      // deny outright when a field is missing -- so a document saved
      // without them would make the "addressed to me" query fail for
      // whoever was named in it, quietly breaking their calendar. The
      // tool always writes both, but the tool isn't the only thing that
      // can reach the database, so the guarantee belongs here.
      allow create: if isSignedIn() && hasProfile() &&
        request.resource.data.author == emailKey() &&
        request.resource.data.visibility in ['private', 'team', 'direct'] &&
        request.resource.data.recipients is list &&
        request.resource.data.date is string;

      // Author is pinned on both sides, so an event can't be reassigned
      // to someone else's address -- which would otherwise plant it in
      // their calendar and lock the original author out of their own
      // entry.
      allow update: if isSignedIn() && hasProfile() &&
        resource.data.author == emailKey() &&
        request.resource.data.author == emailKey() &&
        request.resource.data.visibility in ['private', 'team', 'direct'] &&
        request.resource.data.recipients is list;

      allow delete: if isSignedIn() && hasProfile() &&
        resource.data.author == emailKey();
    }

    // The recurring reporting calendar (JDAI, surveys, year-end
    // close-out, and the ended-but-kept CCLC cycle). Everyone reads it;
    // Admin/Director change it, since it defines obligations for the
    // whole organisation. The "posted" document under here is written by
    // the deadline-to-Todoist job, which runs with admin credentials in
    // GitHub Actions and so isn't restricted by these rules.
    match /reporting_calendar/{docId} {
      allow read: if isSignedIn() && hasProfile();
      allow write: if isAdminOrDirector();
    }

    // The onboarding checklist itself (the sections and items every new
    // hire gets), as opposed to any one hire's ticked boxes above.
    // Everyone signed in needs to read it to see their checklist, but
    // editing it changes what every future hire is onboarded against,
    // so writing is Admin/Director only. The tool hides its Edit button
    // from everyone else, but that's only cosmetic -- anything running
    // in a browser can be bypassed, so the real restriction is here.
    match /onboarding_template/{docId} {
      allow read: if isSignedIn() && hasProfile();
      allow write: if isAdminOrDirector();
    }

    // Receipts (html/Receipts.html) -- replaces Expensify. Private per
    // person: everyone sees and touches only receipts they filed
    // themselves, except the two people who do month-end reconciliation
    // -- named here explicitly, per Brad, rather than by app role.
    // createdBy is pinned on create and immutable after, so a receipt
    // can't be filed as -- or reassigned to -- someone else.
    function isReceiptsAdmin() {
      return emailKey() in ['jake@thecentercc.com', 'brad@thecentercc.com'];
    }

    match /receipts/{receiptId} {
      allow create: if isSignedIn() && hasProfile() &&
        request.resource.data.createdBy == emailKey();
      allow read: if isSignedIn() && hasProfile() &&
        (resource.data.createdBy == emailKey() || isReceiptsAdmin());
      allow update: if isSignedIn() && hasProfile() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (resource.data.createdBy == emailKey() || isReceiptsAdmin());
      allow delete: if isSignedIn() && hasProfile() &&
        (resource.data.createdBy == emailKey() || isReceiptsAdmin());
    }

    // Settings the Receipts tool keeps for itself -- currently just
    // which person each company card belongs to, learned from the
    // Expensify export so Capital One downloads can be filed to the
    // right person. Everyone reads it (it names the owner shown on a
    // row); only the two receipts admins change it.
    match /receipts_config/{docId} {
      allow read: if isSignedIn() && hasProfile();
      allow write: if isReceiptsAdmin();
    }

    // The photo for a receipt, one document per receipt with the same
    // id, kept separate so listing a month reads a few kilobytes of
    // fields instead of megabytes of images. Same privacy as the
    // receipt it belongs to, keyed on who uploaded it.
    match /receipt_images/{receiptId} {
      allow create: if isSignedIn() && hasProfile() &&
        request.resource.data.uploadedBy == emailKey();
      allow read: if isSignedIn() && hasProfile() &&
        (resource.data.uploadedBy == emailKey() || isReceiptsAdmin());
      allow update, delete: if isSignedIn() && hasProfile() &&
        (resource.data.uploadedBy == emailKey() || isReceiptsAdmin());
    }
  }
}
